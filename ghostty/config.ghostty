# ─────────────────────────────────────────────
# Font
# ─────────────────────────────────────────────

font-family = JetBrainsMono Nerd Font
font-size = 14

# ─────────────────────────────────────────────
# Appearance
# ─────────────────────────────────────────────

theme = Gruvbox Dark

# Gruvbox ships a cream #ebdbb2 as both foreground and bright-white, which
# reads dim against the translucent background. Override after the theme so
# these win over it. Backgrounds and accents stay gruvbox; text goes off-white.
foreground = #e8e8e8
palette = 7=#ebdbb2
palette = 15=#f2f2f2

background-opacity = 0.8
background-blur = 20

# Only cells with the default background go transparent, so tmux panes
# see through while selections and syntax highlighting stay crisp.
background-opacity-cells = false


# ─────────────────────────────────────────────
# Cursor
# ─────────────────────────────────────────────

cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true


# ─────────────────────────────────────────────
# Keyboard
# ─────────────────────────────────────────────

# Right Option sends Alt, so TUI chords like <a-h>/<a-i> reach Neovim.
# Left Option stays a compose key for accented characters.
macos-option-as-alt = right


# ─────────────────────────────────────────────
# Clipboard
# ─────────────────────────────────────────────

copy-on-select = false


# ─────────────────────────────────────────────
# Scrollback
# ─────────────────────────────────────────────

scrollback-limit = 100000000


# ─────────────────────────────────────────────
# Shell integration
# ─────────────────────────────────────────────

shell-integration = zsh

